# Copie este arquivo para .env e substitua os valores marcados antes de subir.
IDENTITY_HUB_DB_NAME=identity_hub
IDENTITY_HUB_DB_USERNAME=identity_hub
IDENTITY_HUB_DB_PASSWORD=change-this-database-password
IDENTITY_HUB_POSTGRES_PORT=5432

# URL que o navegador usará para acessar o Identity Hub, sem barra no final.
IDENTITY_HUB_PUBLIC_URL=http://localhost:4200
IDENTITY_HUB_HTTP_PORT=4200
IDENTITY_HUB_BACKEND_PORT=8080
IDENTITY_HUB_RESOURCE_SERVER_PORT=8081
IDENTITY_HUB_COOKIE_SECURE=false

# Origem da chave de assinatura. "generated" é somente para desenvolvimento e
# invalida tokens a cada reinício. Em ambientes estáveis use "pem" e monte os
# arquivos externos no container como recursos file: somente leitura.
IDENTITY_HUB_SIGNING_KEY_SOURCE=generated
IDENTITY_HUB_SIGNING_KEY_ID=
IDENTITY_HUB_SIGNING_PRIVATE_KEY_LOCATION=
IDENTITY_HUB_SIGNING_PUBLIC_KEY_LOCATION=

# SMTP usado para cadastro, verificação de e-mail e recuperação de senha. No Docker Desktop, o host
# abaixo aponta para um servidor SMTP executado na máquina local.
IDENTITY_HUB_MAIL_HOST=host.docker.internal
IDENTITY_HUB_MAIL_PORT=1025
IDENTITY_HUB_MAIL_FROM=no-reply@identityhub.local
IDENTITY_HUB_MAIL_AUTH=false
IDENTITY_HUB_MAIL_STARTTLS=false
IDENTITY_HUB_MAIL_USERNAME=
IDENTITY_HUB_MAIL_PASSWORD=
IDENTITY_HUB_EMAIL_VERIFICATION_TTL=30m
IDENTITY_HUB_PASSWORD_RECOVERY_TTL=15m
IDENTITY_HUB_LOGIN_FAILURE_THRESHOLD=5
IDENTITY_HUB_LOGIN_INITIAL_LOCK_DURATION=1m
IDENTITY_HUB_LOGIN_MAXIMUM_LOCK_DURATION=15m
IDENTITY_HUB_RATE_LIMIT_WINDOW=1m
IDENTITY_HUB_RATE_LIMIT_SUBJECT=10
IDENTITY_HUB_RATE_LIMIT_ORIGIN=60
IDENTITY_HUB_RATE_LIMIT_COMBINATION=8
IDENTITY_HUB_RATE_LIMIT_MAXIMUM_BUCKETS=100000

# Chave AES-256 em Base64 URL-safe para proteger segredos TOTP. Gere 32 bytes aleatórios.
IDENTITY_HUB_MFA_ENCRYPTION_KEY=replace-with-32-random-bytes-in-base64url

# Bootstrap da primeira fatia vertical. Desabilite após provisionar dados reais.
IDENTITY_HUB_BOOTSTRAP_ENABLED=true
IDENTITY_HUB_DEMO_EMAIL=admin@identityhub.local
IDENTITY_HUB_DEMO_PASSWORD=change-this-demo-password
IDENTITY_HUB_DEMO_NAME=Administrador Identity Hub
IDENTITY_HUB_DEMO_CLIENT_ID=identity-hub-demo
IDENTITY_HUB_DEMO_CLIENT_NAME=Cliente demonstrativo Identity Hub
IDENTITY_HUB_DEMO_TENANT_SLUG=identity-hub-demo
IDENTITY_HUB_DEMO_TENANT_NAME=Organização demonstrativa
# O Compose registra IDENTITY_HUB_PUBLIC_URL + /demo/logout como retorno pós-logout.

IDENTITY_HUB_IMAGE_TAG=local
