# Copie para .env e substitua todos os valores antes de executar o overlay HA.
IDENTITY_HUB_DB_PASSWORD=change-this-database-password
IDENTITY_HUB_REDIS_PASSWORD=change-this-redis-password
IDENTITY_HUB_MFA_ENCRYPTION_KEY=replace-with-32-random-bytes-in-base64url
IDENTITY_HUB_DEMO_PASSWORD=change-this-demo-password
IDENTITY_HUB_PUBLIC_URL=https://identity.example.gov
IDENTITY_HUB_COOKIE_SECURE=true

# As duas ou mais réplicas devem montar exatamente o mesmo par RSA externo.
IDENTITY_HUB_BACKEND_REPLICAS=2
IDENTITY_HUB_HA_PRIVATE_KEY_FILE=./secrets/identity-hub-signing-private.pem
IDENTITY_HUB_HA_PUBLIC_KEY_FILE=./secrets/identity-hub-signing-public.pem
